# api/.env.example —— 入库的模板，**只有键名和默认值，没有真值**。
#
# 真正的 .env 在 .gitignore 里，永不进仓库（ADR-010）。
# 部署时把下面的键填到平台的环境变量面板里，本地想覆盖就复制成 api/.env。
#
# 所有键都有代码里的默认值（app/core/config.py），
# 所以本地开发**什么都不设也能跑起来**。

# 运行环境标识。会出现在 /api/v1/health 的 env 字段，也用来区分本地与线上。
# 本地默认 local；线上部署时设成 production。
ENV=local

# 内容目录。
# 默认 = 仓库根的 web/content（从 api/ 起服务时即 ../web/content）。
# 容器里必须显式设成 /app/web/content（见 api/Dockerfile）。
CONTENT_DIR=

# CORS 白名单，逗号分隔。
# 注意 origin 只有「协议 + 域名 + 端口」，**不含路径**，所以不写仓库名 ——
# 正确：https://mucheng-zzb.github.io    错误：https://mucheng-zzb.github.io/personal-portfolio
# 不设则用代码里的默认值：本地 Vite 的 5173 / 4173（含 127.0.0.1 两种写法）+ 线上 Pages。
CORS_ORIGINS=
