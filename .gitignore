# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
# 由 npm run build 生成，不入库：部署时现构建（CI 会跑）
dist/
# 降级冒烟测试专用的那份产物（VITE_API_BASE 指向死域名），由
# web/scripts/build-api-down.mjs 生成。它只服务于测试，永远不该被部署。
dist-api-down/

# ---------- 测试产物 ----------
# Playwright 的报告与 trace（失败时才有）。它们可能含页面截图，不入库。
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------- 密钥与环境变量（ADR-010：密钥永不进仓库）----------
# .env.example 是模板，必须入库；真实的 .env 只放本地和部署平台
.env
.env.*
!.env.example

# ---------- Python（v0.5 起用得上，先占位）----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# pytest 的临时目录（tmp_path 的落点）。正常应该在系统 temp 里，
# 但 TEMP 不可写时 tempfile 会退回到当前目录 —— 这个项目里就是 api/。
pytest-of-*/

# ---------- 编辑器与系统 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- 日志与缓存 ----------
*.log
npm-debug.log*
.vite/
coverage/
