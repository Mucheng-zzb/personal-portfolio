    "smoke": "npm run build && node scripts/build-api-down.mjs && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0"
  }
}
